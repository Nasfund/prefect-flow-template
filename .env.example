# Copy to `.env` and edit. `.env` is git-ignored — never commit real secrets.

# Point the Prefect CLI / deploys at the self-hosted server.
PREFECT_API_URL=http://192.168.50.70:4200/api

# Secrets live in Prefect blocks, NOT in this file. This only NAMES what's needed:
#   GITHUB_PAT  -> the least-privilege PAT for non-interactive git auth; used once by
#                  setup_blocks.py to create the `github-pat` Secret block, which
#                  Prefect renders into the clone URL at deploy time. See the README
#                  "One-time server setup" for the recommended inline-token approach.
