# Per-flow virtual environment (recreated on the server by `uv sync`)
.venv/

# Python bytecode / caches
__pycache__/
*.py[cod]

# Test artifacts
.pytest_cache/

# NOTE: `.kiro/` is deliberately NOT ignored. Steering files and flow specs are
# shared team assets and belong in git so every clone (and every Kiro session)
# gets the same project knowledge.

# Local environment / secrets (never commit real secrets — use Prefect blocks)
.env
